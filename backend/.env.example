PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
# Replace with an independent random secret of at least 32 characters in production.
MEDIA_TOKEN_SECRET=replace-me
MEDIA_TOKEN_TTL_SECONDS=300
# Use Neon's pooled URL for the running API. Keep the direct URL for one-off migration/import scripts.
DATABASE_URL=
DIRECT_DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=appdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
CONTACT_RATE_LIMIT_WINDOW_MS=60000
CONTACT_RATE_LIMIT_MAX_REQUESTS=5
NEWSLETTER_RATE_LIMIT_WINDOW_MS=60000
NEWSLETTER_RATE_LIMIT_MAX_REQUESTS=10
NEWSLETTER_WEBHOOK_SECRET=
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173,http://localhost:4174,http://127.0.0.1:4174
FRONTEND_URL=http://localhost:5173
# Required in production to protect /api/v1/observability/*; leave empty for local development.
OBSERVABILITY_TOKEN=
ADMIN_EMAIL=admin@voiceofdigi.org
ADMIN_PASSWORD=change-this-password
ADMIN_PASSWORD_HASH=
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_LOGIN_RATE_LIMIT_MAX_REQUESTS=5
GOOGLE_CLIENT_ID=
# Add the same value to frontend/.env as VITE_GOOGLE_CLIENT_ID.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PASSWORD_RESET_OTP_TTL_MINUTES=10

PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
# Generate a dedicated random secret of at least 32 characters for OTP HMACs.
OTP_HASH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Replace with an independent random secret of at least 32 characters in production.
MEDIA_TOKEN_SECRET=replace-me
MEDIA_TOKEN_TTL_SECONDS=300
# Use Neon's pooled URL for the running API. Keep the direct URL for one-off migration/import scripts.
DATABASE_URL=
DIRECT_DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=appdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Local development default only. Production requires TLS and certificate verification.
POSTGRES_SSL=false
# Cancel individual PostgreSQL statements that exceed this API query budget.
DATABASE_STATEMENT_TIMEOUT_MS=15000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
CONTACT_RATE_LIMIT_WINDOW_MS=60000
CONTACT_RATE_LIMIT_MAX_REQUESTS=5
NEWSLETTER_RATE_LIMIT_WINDOW_MS=60000
NEWSLETTER_RATE_LIMIT_MAX_REQUESTS=10
NEWSLETTER_WEBHOOK_SECRET=
NEWSLETTER_WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
NEWSLETTER_WEBHOOK_RATE_LIMIT_MAX_REQUESTS=300
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173,http://localhost:4174,http://127.0.0.1:4174,https://voiceofdigibengal.com,https://www.voiceofdigibengal.com
FRONTEND_URL=https://voiceofdigibengal.com
# Required in production for the legacy read-only /observability/snapshot and /stream routes.
# The hosted metrics dashboard uses administrator sign-in; browser telemetry writes are rate-limited.
OBSERVABILITY_TOKEN=
ADMIN_EMAIL=admin@voiceofdigi.org
ADMIN_PASSWORD=change-this-password
ADMIN_PASSWORD_HASH=
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_LOGIN_RATE_LIMIT_MAX_REQUESTS=5
GOOGLE_CLIENT_ID=
# Add the same value to frontend/.env as VITE_GOOGLE_CLIENT_ID.
# Required in production; configure the matching site key in frontend/.env.
TURNSTILE_SECRET_KEY=
SIGNUP_RATE_LIMIT_WINDOW_MS=900000
SIGNUP_RATE_LIMIT_MAX_REQUESTS=5
SMTP_HOST=
# Production requires port 465 with implicit TLS, or port 587 with mandatory STARTTLS.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PASSWORD_RESET_OTP_TTL_MINUTES=10
# Optional provider for editor-requested metadata drafts only; chatbot retrieval does not use it.
# Keep both credentials server-side and leave blank to disable AI metadata suggestions.
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_MODEL=
